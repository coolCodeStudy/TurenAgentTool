# Optional local Codex App bridge configuration.
# Prefer connecting Codex App directly to the cloud InvestmentKnowledge MCP:
#   http://<ECS_HOST>:8000/mcp
#
# Use this file only if you run scripts/hermes_mcp_bridge.py locally.
# Copy to .env.codex and fill values locally. Never commit .env.codex.

COMMAND_API_URL=http://<ECS_HOST>:8001
COMMAND_API_TOKEN=

OPS_API_URL=http://<ECS_HOST>:8767
OPS_API_TOKEN=

HERMES_BRIDGE_TIMEOUT_SECONDS=20
